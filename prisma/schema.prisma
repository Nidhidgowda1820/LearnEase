generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model notes {
  id           Int       @id @default(autoincrement())
  user_id      String?   @db.Uuid
  subject_code String?   @db.VarChar(16)
  note         String?
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  profiles profiles? @relation(fields: [user_id], references: [id])

  @@schema("public")
}

model profiles {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String?   @db.VarChar(80)
  email      String?   @unique @db.VarChar(120)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  password   String    @db.VarChar(255)
  notes      notes[]

  @@schema("public")
}

model syllabus {
  id           Int     @id @default(autoincrement())
  subject_code String? @db.VarChar(16)
  subject      String? @db.VarChar(128)
  semester     Int?

  @@schema("public")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  branch    String?
  year      Int?
  createdAt DateTime @default(now())

  @@schema("public")
}

model documents {
  id         BigInt    @id @default(autoincrement())
  subject    String?
  module     String?
  marks_type String?
  question   String?
  answer     String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model quizzes {
  id           Int      @id @default(autoincrement())
  subject_code String   @db.VarChar(16)
  topic        String
  question     String
  options      String[] @db.VarChar(255) // array of answer options
  correct      Int // index of correct option in options array
  created_at   DateTime @default(now())

  @@schema("public")
}
